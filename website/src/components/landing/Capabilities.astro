---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const tiles = [
  {
    title: "HSM-only signing",
    body: "Ed25519 (Solana) and secp256k1 (Cosmos) live inside the YubiHSM2. The runtime auth key can sign but cannot export.",
    href: `${baseUrl}/concepts/security-model/`,
    icon: "shield",
  },
  {
    title: "Deterministic ceremony",
    body: "One BIP-39 mnemonic seeds ceremony, provisioner, signer, and the AES-256-CCM wrap key. Lose hardware, restore in minutes.",
    href: `${baseUrl}/guides/quick-start/`,
    icon: "ceremony",
  },
  {
    title: "Per-key policy",
    body: "Rate limits per minute / hour / day, per-tx and rolling daily caps, plus program / message-type / recipient allowlists.",
    href: `${baseUrl}/guides/policy-authoring/`,
    icon: "policy",
  },
  {
    title: "Kill switch + overlays",
    body: "Disable a key without deleting it. Persist partial overlays through the admin API; baseline config stays untouched.",
    href: `${baseUrl}/reference/http-api/#admin-policy-overlays`,
    icon: "killswitch",
  },
  {
    title: "Audit + metrics",
    body: "Append-only JSONL audit with optional HMAC chain. Prometheus exposes accept / deny counters with policy reasons.",
    href: `${baseUrl}/reference/http-api/`,
    icon: "metrics",
  },
  {
    title: "Chain-agnostic",
    body: "Add a chain by implementing the Rust ChainSigner trait. Policy, audit, replay, and metrics layers stay shared.",
    href: `${baseUrl}/reference/architecture/`,
    icon: "chain",
  },
];
---

<section class="relative" aria-labelledby="capabilities-heading">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p
        class="text-xs font-semibold uppercase tracking-[0.18em] text-accent-300"
      >
        What ships in the box
      </p>
      <h2
        id="capabilities-heading"
        class="mt-3 text-balance text-3xl font-semibold tracking-tight text-white sm:text-4xl"
      >
        Everything an autonomous strategy needs to never touch a key.
      </h2>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        tiles.map((tile) => (
          <a
            href={tile.href}
            class="reveal group relative flex flex-col gap-3 rounded-2xl border border-white/10 bg-gradient-to-b from-white/[0.04] to-white/[0.01] p-6 transition hover:-translate-y-0.5 hover:border-accent-500/40 hover:bg-accent-500/[0.04]"
          >
            <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-accent-500/30 bg-accent-500/10 text-accent-300">
              {tile.icon === "shield" && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z" />
                  <path d="m9 12 2 2 4-4" />
                </svg>
              )}
              {tile.icon === "ceremony" && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="3" />
                  <path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1" />
                </svg>
              )}
              {tile.icon === "policy" && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 4h11l3 3v13H5z" />
                  <path d="M9 10h7M9 14h7M9 18h4" />
                </svg>
              )}
              {tile.icon === "killswitch" && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5" />
                  <circle cx="12" cy="16" r="0.5" fill="currentColor" />
                </svg>
              )}
              {tile.icon === "metrics" && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 19h16" />
                  <path d="M6 16V9M11 16v-4M16 16V6" />
                </svg>
              )}
              {tile.icon === "chain" && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 15a4 4 0 0 1 0-6l3-3a4 4 0 1 1 6 6l-1 1" />
                  <path d="M15 9a4 4 0 0 1 0 6l-3 3a4 4 0 1 1-6-6l1-1" />
                </svg>
              )}
            </div>
            <h3 class="text-lg font-semibold text-white">{tile.title}</h3>
            <p class="text-sm text-fog-200">{tile.body}</p>
            <span class="mt-auto inline-flex items-center gap-1 text-sm font-medium text-accent-300">
              Learn more
              <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
