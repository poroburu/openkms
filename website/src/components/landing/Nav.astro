---
import Logo from "./Logo.astro";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const links = [
  { label: "Docs", href: `${baseUrl}/overview/` },
  { label: "Quick start", href: `${baseUrl}/guides/quick-start/` },
  { label: "HTTP API", href: `${baseUrl}/reference/http-api/` },
  { label: "Architecture", href: `${baseUrl}/reference/architecture/` },
];
---

<header
  class="sticky top-0 z-30 border-b border-white/5 bg-ink-950/60 backdrop-blur"
>
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-3 sm:px-6 lg:px-8"
    aria-label="Primary"
  >
    <a
      href={`${baseUrl}/`}
      class="flex items-center gap-2.5 rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-accent-500"
    >
      <Logo size={28} />
      <span class="text-base font-semibold tracking-tight text-accent-400">
        openKMS
      </span>
      <span
        class="hidden rounded-full border border-accent-500/30 bg-accent-500/10 px-2 py-0.5 text-[11px] font-medium text-accent-400 sm:inline-block"
      >
        v0.1.0-rc.1
      </span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-md px-3 py-2 text-sm text-fog-200 transition-colors hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href="https://github.com/poroburu/openkms"
        target="_blank"
        rel="noreferrer noopener"
        class="hidden items-center gap-2 rounded-md border border-white/10 bg-white/5 px-3 py-1.5 text-sm font-medium text-white transition hover:border-accent-500/40 hover:bg-accent-500/10 sm:inline-flex"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 2C6.477 2 2 6.485 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.009-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.339-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.847-2.339 4.695-4.566 4.943.359.31.678.92.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.485 17.522 2 12 2Z"
          />
        </svg>
        <span>GitHub</span>
      </a>
      <a
        href={`${baseUrl}/guides/quick-start/`}
        class="inline-flex items-center gap-1 rounded-md bg-accent-500 px-3 py-1.5 text-sm font-semibold text-ink-950 shadow-glow transition hover:bg-accent-400"
      >
        Quick start
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </nav>
</header>
