---
import Logo from "./Logo.astro";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const groups = [
  {
    title: "Start",
    links: [
      { label: "Overview", href: `${baseUrl}/overview/` },
      { label: "Quick start", href: `${baseUrl}/guides/quick-start/` },
      { label: "Security model", href: `${baseUrl}/concepts/security-model/` },
    ],
  },
  {
    title: "Operate",
    links: [
      { label: "Configuration", href: `${baseUrl}/guides/configuration/` },
      { label: "Policy authoring", href: `${baseUrl}/guides/policy-authoring/` },
      { label: "Openclaw integration", href: `${baseUrl}/guides/openclaw-integration/` },
      { label: "Deployment", href: `${baseUrl}/operations/deployment/` },
      { label: "Backup & restore", href: `${baseUrl}/operations/backup-restore/` },
      { label: "Testing", href: `${baseUrl}/operations/testing/` },
    ],
  },
  {
    title: "Reference",
    links: [
      { label: "HTTP API", href: `${baseUrl}/reference/http-api/` },
      { label: "Architecture", href: `${baseUrl}/reference/architecture/` },
      {
        label: "OpenAPI spec",
        href: "https://github.com/poroburu/openkms/blob/main/openapi/openkms.v1.json",
        external: true,
      },
      {
        label: "Source code",
        href: "https://github.com/poroburu/openkms",
        external: true,
      },
    ],
  },
];
---

<section
  class="relative border-t border-white/10"
  aria-labelledby="cta-heading"
>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-64 bg-[radial-gradient(60rem_30rem_at_50%_-10%,rgba(56,189,248,0.18),transparent_60%)]"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div
      class="reveal mx-auto max-w-3xl rounded-3xl border border-white/10 bg-gradient-to-b from-ink-900/80 to-ink-800/30 p-10 text-center shadow-card"
    >
      <h2
        id="cta-heading"
        class="text-balance text-3xl font-semibold tracking-tight text-white sm:text-4xl"
      >
        Run it on a Pi today.
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-balance text-fog-200">
        One BIP-39 mnemonic, a YubiHSM2, and a Raspberry Pi. Your strategy
        signs through a deny-by-default boundary and your keys never leave
        the device.
      </p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
        <a
          href={`${baseUrl}/guides/quick-start/`}
          class="inline-flex items-center gap-2 rounded-lg bg-accent-500 px-5 py-3 text-sm font-semibold text-ink-950 shadow-glow transition hover:bg-accent-400"
        >
          Run the quick start
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="https://github.com/poroburu/openkms"
          target="_blank"
          rel="noreferrer noopener"
          class="inline-flex items-center gap-2 rounded-lg border border-white/15 bg-white/[0.04] px-5 py-3 text-sm font-semibold text-white transition hover:border-accent-500/40 hover:bg-accent-500/10"
        >
          View on GitHub
        </a>
        <a
          href="https://github.com/poroburu/openkms/blob/main/openapi/openkms.v1.json"
          target="_blank"
          rel="noreferrer noopener"
          class="inline-flex items-center gap-1 rounded-lg px-3 py-3 text-sm font-medium text-fog-200 transition hover:text-white"
        >
          OpenAPI spec
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<footer class="border-t border-white/10 bg-ink-950/60">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
      <div>
        <a
          href={`${baseUrl}/`}
          class="flex items-center gap-2.5 rounded-lg outline-none focus-visible:ring-2 focus-visible:ring-accent-500"
        >
          <Logo size={32} />
          <span class="text-base font-semibold tracking-tight text-white">
            openKMS
          </span>
        </a>
        <p class="mt-4 max-w-sm text-sm text-fog-300">
          A YubiHSM2-backed transaction signer for Cosmos and Solana.
          Designed for homelab operators and autonomous trading agents.
        </p>
        <p class="mt-4 text-xs text-fog-400">
          Apache-2.0 · v0.1.0-rc.1 · Submitted to a hackathon and startup
          competition near you.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {
          groups.map((g) => (
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-fog-400">
                {g.title}
              </p>
              <ul class="mt-3 space-y-2">
                {g.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.external ? "_blank" : undefined}
                      rel={link.external ? "noreferrer noopener" : undefined}
                      class="text-sm text-fog-200 transition hover:text-white"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</footer>
