---
import { Code } from "astro:components";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const requestBody = `{
  "label": "solana-hot-0",
  "expected_chain_id": "mainnet-beta",
  "message_b64": "<base64 VersionedMessage>",
  "address_lookup_tables": [
    { "key": "<ALT pubkey>", "addresses": ["<base58>", "..."] }
  ]
}`;

const curlSign = `curl -sS -X POST \\
  -H "Authorization: Bearer $(cat signer.token)" \\
  -H "Content-Type: application/json" \\
  http://pi.local:9443/sign/solana \\
  -d @sign-request.json`;

const responseBody = `{
  "signature_b64": "<base64 64-byte ed25519>"
}`;

const denialBody = `{
  "error": "policy: per_tx_cap_lamports exceeded (cap=5000000000, attempted=12000000000)"
}`;

const tiles = [
  {
    title: "Policy inspection",
    body: "GET /policy/{label} returns the effective policy plus runtime counters so agents self-throttle.",
    href: `${baseUrl}/reference/http-api/#policy-inspection`,
    cta: "Read the route",
  },
  {
    title: "Admin overlays",
    body: "PATCH a partial overlay onto a key without rewriting config. Persisted, restart-safe, fully audited.",
    href: `${baseUrl}/reference/http-api/#admin-policy-overlays`,
    cta: "See the schema",
  },
  {
    title: "OpenAPI v1",
    body: "Generated from the Rust source at build time. CI fails on drift so the spec is always live.",
    href: "https://github.com/poroburu/openkms/blob/main/openapi/openkms.v1.json",
    cta: "View the spec",
    external: true,
  },
];
---

<section class="relative" aria-labelledby="api-heading">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p
        class="text-xs font-semibold uppercase tracking-[0.18em] text-accent-300"
      >
        Sign over HTTP
      </p>
      <h2
        id="api-heading"
        class="mt-3 text-balance text-3xl font-semibold tracking-tight text-white sm:text-4xl"
      >
        One bearer token. Two chains. Zero key egress.
      </h2>
      <p class="mt-4 text-balance text-lg text-fog-200">
        openKMS speaks plain HTTP on loopback or behind your proxy. Your
        agent posts a chain-native message; it gets back a signature, never
        a key.
      </p>
    </div>

    <div class="reveal mt-12 grid gap-5 lg:grid-cols-2">
      <div
        class="overflow-hidden rounded-2xl border border-white/10 bg-ink-900/60 shadow-card"
      >
        <div
          class="flex items-center gap-2 border-b border-white/10 bg-white/[0.03] px-4 py-2.5"
        >
          <span class="rounded bg-accent-500/15 px-2 py-0.5 font-mono text-[10px] font-semibold text-accent-300">
            POST
          </span>
          <span class="font-mono text-[12px] text-white">/sign/solana</span>
          <span class="ml-auto rounded-full border border-white/10 px-2 py-0.5 font-mono text-[10px] text-fog-300">
            request
          </span>
        </div>
        <div class="px-4 py-4 text-[12.5px]">
          <Code code={curlSign} lang="bash" theme="github-dark-default" />
          <div class="my-4 h-px bg-white/10"></div>
          <div class="mb-2 font-mono text-[10px] uppercase tracking-widest text-fog-400">
            sign-request.json
          </div>
          <Code code={requestBody} lang="json" theme="github-dark-default" />
        </div>
      </div>

      <div class="flex flex-col gap-5">
        <div
          class="overflow-hidden rounded-2xl border border-good-500/20 bg-good-500/[0.04] shadow-card"
        >
          <div
            class="flex items-center gap-2 border-b border-good-500/20 bg-good-500/10 px-4 py-2.5"
          >
            <span class="rounded bg-good-500/15 px-2 py-0.5 font-mono text-[10px] font-semibold text-good-500">
              200
            </span>
            <span class="font-mono text-[12px] text-fog-200">policy passed · HSM signed</span>
          </div>
          <div class="px-4 py-4 text-[12.5px]">
            <Code code={responseBody} lang="json" theme="github-dark-default" />
          </div>
        </div>

        <div
          class="overflow-hidden rounded-2xl border border-danger-500/20 bg-danger-500/[0.04] shadow-card"
        >
          <div
            class="flex items-center gap-2 border-b border-danger-500/20 bg-danger-500/10 px-4 py-2.5"
          >
            <span class="rounded bg-danger-500/15 px-2 py-0.5 font-mono text-[10px] font-semibold text-danger-500">
              403
            </span>
            <span class="font-mono text-[12px] text-fog-200">policy denied · HSM never touched</span>
          </div>
          <div class="px-4 py-4 text-[12.5px]">
            <Code code={denialBody} lang="json" theme="github-dark-default" />
          </div>
        </div>
      </div>
    </div>

    <div class="reveal mt-10 grid gap-4 md:grid-cols-3">
      {
        tiles.map((tile) => (
          <a
            href={tile.href}
            target={tile.external ? "_blank" : undefined}
            rel={tile.external ? "noreferrer noopener" : undefined}
            class="group flex flex-col rounded-2xl border border-white/10 bg-white/[0.02] p-5 transition hover:border-accent-500/40 hover:bg-accent-500/[0.04]"
          >
            <h3 class="text-base font-semibold text-white">{tile.title}</h3>
            <p class="mt-2 flex-1 text-sm text-fog-200">{tile.body}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent-300 group-hover:text-accent-200">
              {tile.cta}
              <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
