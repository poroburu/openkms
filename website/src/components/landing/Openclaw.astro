---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const steps = [
  {
    n: "01",
    actor: "Strategy",
    title: "GET /policy/{label}",
    body:
      "Inspect effective limits and live counters before constructing a trade. If a daily cap is nearly exhausted, wait or escalate.",
  },
  {
    n: "02",
    actor: "Strategy",
    title: "Build the transaction",
    body:
      "Construct a chain-native message (VersionedMessage for Solana, SignDoc for Cosmos). openKMS never sees the strategy logic.",
  },
  {
    n: "03",
    actor: "openKMS",
    title: "POST /sign/{chain}",
    body:
      "Decode → policy → replay cache → HSM. A denial is a 403 / 429 with a precise reason. An accept records to the audit log.",
  },
  {
    n: "04",
    actor: "Strategy",
    title: "Broadcast through chain RPC",
    body:
      "openKMS never broadcasts. The strategy assembles signature + message and submits to the chain. The signing boundary stays narrow.",
  },
];

const callouts = [
  {
    title: "Self-throttling agents",
    body:
      "Agents read policy before they sign. Runtime counters tell them when a window is full so they back off instead of probing for a denial.",
  },
  {
    title: "Bounded blast radius",
    body:
      "Per-tx caps limit a single bad trade. Daily caps limit sustained bad behavior. The admin kill switch stops a key without deleting it.",
  },
  {
    title: "AgentSkills-compatible manual",
    body:
      "An operator manual ships at .agents/skills/openkms/SKILL.md so any AgentSkills-aware agent can correctly call openKMS without bespoke onboarding.",
    href: "https://github.com/poroburu/openkms/blob/main/.agents/skills/openkms/SKILL.md",
  },
];
---

<section class="relative" aria-labelledby="openclaw-heading">
  <div
    class="pointer-events-none absolute inset-x-0 -z-0 h-full bg-[radial-gradient(60rem_30rem_at_50%_50%,rgba(56,189,248,0.08),transparent_55%)]"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-28">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p
        class="text-xs font-semibold uppercase tracking-[0.18em] text-accent-300"
      >
        Built for autonomous agents
      </p>
      <h2
        id="openclaw-heading"
        class="mt-3 text-balance text-3xl font-semibold tracking-tight text-white sm:text-4xl"
      >
        How an Openclaw strategy uses openKMS.
      </h2>
      <p class="mt-4 text-balance text-lg text-fog-200">
        openKMS is the signing boundary, not the strategy. Agents construct
        transactions, ask for a signature, and broadcast — the policy engine
        keeps a buggy or compromised agent from draining an account.
      </p>
    </div>

    <div class="reveal mt-12 grid gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:items-start">
      <ol class="relative space-y-4 border-l border-white/10 pl-6">
        {
          steps.map((step) => (
            <li class="relative">
              <span
                class:list={[
                  "absolute -left-[33px] top-1 flex h-6 w-6 items-center justify-center rounded-full border font-mono text-[10px] font-semibold",
                  step.actor === "openKMS"
                    ? "border-accent-500/50 bg-accent-500/15 text-accent-200"
                    : "border-white/15 bg-white/5 text-fog-200",
                ]}
              >
                {step.n}
              </span>
              <div class="rounded-xl border border-white/10 bg-white/[0.02] p-5">
                <div class="flex items-center gap-2">
                  <span
                    class:list={[
                      "rounded-full px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-widest",
                      step.actor === "openKMS"
                        ? "bg-accent-500/15 text-accent-300"
                        : "bg-white/10 text-fog-200",
                    ]}
                  >
                    {step.actor}
                  </span>
                  <span class="font-mono text-[12px] text-white">
                    {step.title}
                  </span>
                </div>
                <p class="mt-2 text-sm text-fog-200">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="space-y-4">
        {
          callouts.map((c) => (
            <div class="rounded-2xl border border-white/10 bg-gradient-to-b from-white/[0.04] to-transparent p-5">
              <h3 class="text-base font-semibold text-white">{c.title}</h3>
              <p class="mt-2 text-sm text-fog-200">{c.body}</p>
              {c.href && (
                <a
                  href={c.href}
                  target="_blank"
                  rel="noreferrer noopener"
                  class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-accent-300 hover:text-accent-200"
                >
                  Open the skill
                  <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          ))
        }

        <a
          href={`${baseUrl}/guides/openclaw-integration/`}
          class="group flex items-center justify-between rounded-2xl border border-accent-500/30 bg-accent-500/10 p-5 transition hover:bg-accent-500/15"
        >
          <div>
            <h3 class="text-base font-semibold text-white">
              Read the full integration guide
            </h3>
            <p class="mt-1 text-sm text-accent-100">
              Trust boundaries · token scopes · admin overlays · operator
              hand-off.
            </p>
          </div>
          <span
            aria-hidden="true"
            class="text-2xl text-accent-200 transition group-hover:translate-x-1"
          >→</span>
        </a>
      </div>
    </div>
  </div>
</section>
