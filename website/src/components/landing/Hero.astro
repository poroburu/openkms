---
import { Code } from "astro:components";
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");

const curlSnippet = `curl -sS \\
  -H "Authorization: Bearer $(cat signer.token)" \\
  http://pi.local:9443/policy/solana-hot-0`;

const jsonSnippet = `{
  "label": "solana-hot-0",
  "chain": "solana",
  "effective_enabled": true,
  "policy": {
    "enabled": true,
    "max_signs_per_minute": 30,
    "max_signs_per_day": 5000,
    "per_tx_cap_lamports": "5000000000",
    "allowed_programs": [
      { "id": "11111111111111111111111111111111" }
    ]
  },
  "runtime": {
    "sign_counts": {
      "per_minute": { "limit": 30, "used": 0 }
    }
  }
}`;

const flowNodes = [
  {
    label: "Request",
    detail: "Strategy submits a built transaction with a signer token.",
  },
  {
    label: "Policy",
    detail: "Caps, allowlists, and rate limits run before the HSM is touched.",
  },
  {
    label: "YubiHSM2",
    detail: "Signs inside the device. Keys never leave hardware.",
  },
  {
    label: "Signature",
    detail: "Audit log + Prometheus update. Strategy broadcasts.",
  },
];
---

<section class="relative overflow-hidden">
  <div class="grid-bg pointer-events-none absolute inset-0 opacity-50"></div>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 -z-0 h-[44rem] bg-[radial-gradient(60rem_30rem_at_50%_-10%,rgba(56,189,248,0.18),transparent_60%)]"
  >
  </div>

  <div class="mx-auto max-w-7xl px-4 pb-16 pt-12 sm:px-6 lg:px-8 lg:pt-20 lg:pb-24">
    <div class="grid items-center gap-12 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)]">
      <div class="reveal">
        <div
          class="inline-flex items-center gap-2 rounded-full border border-accent-500/25 bg-accent-500/5 px-3 py-1 text-[11px] font-semibold uppercase tracking-widest text-accent-300"
        >
          <span class="relative inline-flex h-2 w-2">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-500 opacity-75"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent-500"
            ></span>
          </span>
          Hardware-backed signing for autonomous agents
        </div>

        <h1
          class="mt-6 text-balance text-4xl font-semibold tracking-tight text-white sm:text-5xl lg:text-[3.5rem] lg:leading-[1.05]"
        >
          Your trading agent shouldn't hold your{" "}
          <span class="bg-gradient-to-r from-accent-400 via-accent-500 to-accent-400 bg-clip-text text-transparent">
            private keys
          </span>
          .
        </h1>

        <p class="mt-5 max-w-2xl text-balance text-lg text-fog-200">
          openKMS is a deny-by-default signing API for Solana and Cosmos,
          backed by a YubiHSM2 you actually own. Autonomous strategies request
          signatures over HTTP. Per-key policy stops the bad trades before the
          hardware ever touches them.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href={`${baseUrl}/guides/quick-start/`}
            class="group inline-flex items-center gap-2 rounded-lg bg-accent-500 px-5 py-3 text-sm font-semibold text-ink-950 shadow-glow transition hover:bg-accent-400"
          >
            Run the quick start
            <span class="transition-transform group-hover:translate-x-0.5"
              aria-hidden="true">→</span>
          </a>
          <a
            href="https://github.com/poroburu/openkms"
            target="_blank"
            rel="noreferrer noopener"
            class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition hover:border-accent-500/40 hover:bg-accent-500/10"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.485 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.009-.868-.014-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.339-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.847-2.339 4.695-4.566 4.943.359.31.678.92.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.485 17.522 2 12 2Z"
              />
            </svg>
            View on GitHub
          </a>
          <a
            href={`${baseUrl}/reference/http-api/`}
            class="inline-flex items-center gap-1 rounded-lg px-3 py-3 text-sm font-medium text-fog-200 transition hover:text-white"
          >
            Read the HTTP API
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <dl
          class="mt-8 grid max-w-xl grid-cols-3 divide-x divide-white/10 rounded-xl border border-white/10 bg-white/[0.02]"
        >
          <div class="px-4 py-3">
            <dt class="text-[11px] font-medium uppercase tracking-widest text-fog-400">
              Chains
            </dt>
            <dd class="mt-1 text-sm font-semibold text-white">
              Solana · Cosmos
            </dd>
          </div>
          <div class="px-4 py-3">
            <dt class="text-[11px] font-medium uppercase tracking-widest text-fog-400">
              Hardware
            </dt>
            <dd class="mt-1 text-sm font-semibold text-white">YubiHSM2</dd>
          </div>
          <div class="px-4 py-3">
            <dt class="text-[11px] font-medium uppercase tracking-widest text-fog-400">
              License
            </dt>
            <dd class="mt-1 text-sm font-semibold text-white">Apache-2.0</dd>
          </div>
        </dl>
      </div>

      <div class="reveal flex flex-col gap-4">
        <div
          class="overflow-hidden rounded-2xl border border-white/10 bg-ink-900/80 shadow-card backdrop-blur"
        >
          <div
            class="flex items-center gap-2 border-b border-white/10 bg-white/[0.03] px-4 py-2.5"
          >
            <span class="h-2.5 w-2.5 rounded-full bg-danger-500/70"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-warn-500/70"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-good-500/70"></span>
            <span class="ml-3 font-mono text-[11px] uppercase tracking-widest text-fog-400">
              GET /policy/solana-hot-0
            </span>
            <span class="ml-auto rounded-full border border-good-500/30 bg-good-500/10 px-2 py-0.5 font-mono text-[10px] font-semibold text-good-500">
              200 OK
            </span>
          </div>
          <div class="grid divide-y divide-white/10 lg:divide-x lg:divide-y-0 xl:grid-cols-1 xl:divide-y xl:divide-x-0">
            <div class="px-4 py-3 text-[12.5px]">
              <div class="mb-2 font-mono text-[10px] uppercase tracking-widest text-fog-400">
                request
              </div>
              <Code code={curlSnippet} lang="bash" theme="github-dark-default" />
            </div>
            <div class="px-4 py-3 text-[12.5px]">
              <div class="mb-2 font-mono text-[10px] uppercase tracking-widest text-fog-400">
                response
              </div>
              <Code code={jsonSnippet} lang="json" theme="github-dark-default" />
            </div>
          </div>
        </div>

        <div
          class="relative overflow-hidden rounded-2xl border border-white/10 bg-gradient-to-br from-ink-900/90 to-ink-800/60 p-4"
          aria-label="openKMS signing flow"
        >
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-[1fr_auto_1fr_auto_1fr_auto_1fr]">
            {
              flowNodes.map((node, idx) => (
                <>
                  <div class="flow-card group">
                    <div class="flow-card-step">{String(idx + 1).padStart(2, "0")}</div>
                    <div class="flow-card-label">{node.label}</div>
                    <div class="flow-card-detail">{node.detail}</div>
                  </div>
                  {idx < flowNodes.length - 1 && (
                    <span class="flow-arrow" aria-hidden="true">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                        <path
                          d="M4 12h14m0 0-5-5m5 5-5 5"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="animate-flow-march"
                        />
                      </svg>
                    </span>
                  )}
                </>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .flow-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-radius: 0.875rem;
    border: 1px solid rgba(148, 163, 184, 0.15);
    background: rgba(15, 23, 42, 0.7);
    padding: 0.85rem 0.95rem;
    transition: border-color 160ms ease, transform 160ms ease,
      box-shadow 160ms ease;
  }

  .flow-card:hover {
    border-color: rgba(56, 189, 248, 0.55);
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -16px rgba(56, 189, 248, 0.45);
  }

  .flow-card-step {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    color: rgba(125, 211, 252, 0.85);
  }

  .flow-card-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: #f8fafc;
  }

  .flow-card-detail {
    font-size: 0.78rem;
    line-height: 1.35;
    color: rgba(203, 213, 225, 0.8);
  }

  .flow-arrow {
    color: rgba(125, 211, 252, 0.85);
    align-self: center;
    justify-self: center;
  }

  @media (max-width: 640px) {
    .flow-arrow {
      transform: rotate(90deg);
    }
  }
</style>
