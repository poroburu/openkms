---
import logoSrc from "../../../../brand/logo.svg";

interface Props {
  size?: number;
  withText?: boolean;
  class?: string;
}
const { size = 32, withText = false, class: className = "" } = Astro.props;
---

<span class={`inline-flex items-center gap-2 ${className}`}>
  <img
    src={logoSrc.src}
    width={size}
    height={size}
    alt="openKMS"
    class="shrink-0"
  />
  {
    withText && (
      <span class="text-base font-semibold tracking-tight text-accent-400">
        openKMS
      </span>
    )
  }
</span>
