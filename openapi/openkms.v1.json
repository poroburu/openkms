{
  "components": {
    "responses": {
      "BadRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Request payload could not be decoded or validated."
      },
      "Conflict": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Pool exhausted or label already paired."
      },
      "Forbidden": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Policy denied the request."
      },
      "InternalError": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Internal server or HSM error."
      },
      "NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Requested key label was not found."
      },
      "RateLimited": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Rate-limit policy denied the request."
      },
      "ServiceUnavailable": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Balance RPC unavailable for most/least pick."
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Bearer token is missing or invalid."
      }
    },
    "schemas": {
      "ActivePairing": {
        "properties": {
          "client_id": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "paired_at": {
            "type": "integer"
          },
          "revoked_at": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "client_id",
          "label",
          "paired_at"
        ],
        "type": "object"
      },
      "AdminKeyResponse": {
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "enabled"
        ],
        "type": "object"
      },
      "AllowedMessage": {
        "properties": {
          "allowed_contracts": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "allowed_methods": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "allowed_recipients": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "comment": {
            "type": [
              "string",
              "null"
            ]
          },
          "per_tx_cap": {
            "additionalProperties": {
              "type": "string"
            },
            "type": [
              "object",
              "null"
            ]
          },
          "type_url": {
            "type": "string"
          }
        },
        "required": [
          "type_url"
        ],
        "type": "object"
      },
      "AllowedProgram": {
        "properties": {
          "comment": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "AllowedRecipient": {
        "properties": {
          "addresses": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "program": {
            "type": "string"
          }
        },
        "required": [
          "program",
          "addresses"
        ],
        "type": "object"
      },
      "ChainPoolStats": {
        "properties": {
          "allocatable": {
            "type": "integer"
          },
          "can_allocate": {
            "type": "boolean"
          },
          "configured": {
            "type": "integer"
          },
          "paired": {
            "type": "integer"
          },
          "reserved": {
            "type": "integer"
          }
        },
        "required": [
          "configured",
          "allocatable",
          "paired",
          "reserved",
          "can_allocate"
        ],
        "type": "object"
      },
      "CosmosSignRequest": {
        "additionalProperties": false,
        "properties": {
          "expected_chain_id": {
            "description": "Must match the chain_id inside the decoded SignDoc.",
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "sign_doc_b64": {
            "description": "Base64-encoded cosmos.tx.v1beta1.SignDoc.",
            "type": "string"
          }
        },
        "required": [
          "label",
          "sign_doc_b64",
          "expected_chain_id"
        ],
        "type": "object"
      },
      "DailySpend": {
        "properties": {
          "cap": {
            "type": [
              "string",
              "null"
            ]
          },
          "day_unix": {
            "type": "integer"
          },
          "spent": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "day_unix",
          "spent",
          "cap"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "hsm_up": {
            "description": "Null on the first response after process start; boolean thereafter.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "status": {
            "const": "ok",
            "type": "string"
          }
        },
        "required": [
          "status",
          "hsm_up"
        ],
        "type": "object"
      },
      "KeyPolicy": {
        "properties": {
          "allowed_messages": {
            "items": {
              "$ref": "#/components/schemas/AllowedMessage"
            },
            "type": "array"
          },
          "allowed_programs": {
            "items": {
              "$ref": "#/components/schemas/AllowedProgram"
            },
            "type": "array"
          },
          "allowed_recipients": {
            "items": {
              "$ref": "#/components/schemas/AllowedRecipient"
            },
            "type": "array"
          },
          "daily_cap_lamports": {
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "max_signs_per_day": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_signs_per_hour": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_signs_per_minute": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "per_tx_cap_lamports": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "KeyPolicyPatch": {
        "description": "Partial overlay. Non-null fields present in a PATCH replace the corresponding baseline policy field.",
        "properties": {
          "allowed_messages": {
            "items": {
              "$ref": "#/components/schemas/AllowedMessage"
            },
            "type": "array"
          },
          "allowed_programs": {
            "items": {
              "$ref": "#/components/schemas/AllowedProgram"
            },
            "type": "array"
          },
          "allowed_recipients": {
            "items": {
              "$ref": "#/components/schemas/AllowedRecipient"
            },
            "type": "array"
          },
          "daily_cap_lamports": {
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "max_signs_per_day": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_signs_per_hour": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_signs_per_minute": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "per_tx_cap_lamports": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "KeySummary": {
        "properties": {
          "address": {
            "type": "string"
          },
          "chain": {
            "enum": [
              "solana",
              "cosmos",
              "unknown"
            ],
            "type": "string"
          },
          "derivation_path": {
            "examples": [
              "m/44'/118'/0'/0/0"
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          },
          "object_id": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "label",
          "chain",
          "address",
          "enabled",
          "object_id",
          "derivation_path"
        ],
        "type": "object"
      },
      "PairApproveRequest": {
        "properties": {
          "label": {
            "description": "Override label for auto requests.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "PairApproveResponse": {
        "properties": {
          "bearer_source": {
            "enum": [
              "server",
              "client"
            ],
            "type": "string"
          },
          "client_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "pairing_id": {
            "type": "string"
          },
          "pick": {
            "enum": [
              "most",
              "least",
              "random"
            ],
            "type": "string"
          },
          "token": {
            "description": "Present only when bearer_source is server (minted on approve).",
            "type": "string"
          }
        },
        "required": [
          "pairing_id",
          "client_id",
          "label",
          "bearer_source"
        ],
        "type": "object"
      },
      "PairAsset": {
        "properties": {
          "denom": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "native",
              "spl",
              "denom"
            ],
            "type": "string"
          },
          "mint": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "PairRequest": {
        "properties": {
          "asset": {
            "$ref": "#/components/schemas/PairAsset"
          },
          "bearer": {
            "description": "Optional client-generated bearer (okms_ + 64 hex). Hashed at ingest; omit for server-mint on approve.",
            "type": "string"
          },
          "chain": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "pick": {
            "enum": [
              "most",
              "least",
              "random"
            ],
            "type": "string"
          }
        },
        "required": [
          "client_id"
        ],
        "type": "object"
      },
      "PairRequestResponse": {
        "properties": {
          "expires_at": {
            "type": "integer"
          },
          "request_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "status",
          "expires_at"
        ],
        "type": "object"
      },
      "PendingPairRequest": {
        "properties": {
          "asset": {
            "$ref": "#/components/schemas/PairAsset"
          },
          "chain": {
            "type": [
              "string",
              "null"
            ]
          },
          "client_id": {
            "type": "string"
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "pick": {
            "enum": [
              "most",
              "least",
              "random"
            ],
            "type": "string"
          },
          "request_kind": {
            "enum": [
              "labeled",
              "auto"
            ],
            "type": "string"
          },
          "requested_at": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "client_id",
          "request_kind",
          "requested_at",
          "expires_at"
        ],
        "type": "object"
      },
      "PolicyRuntime": {
        "properties": {
          "daily_spend": {
            "items": {
              "$ref": "#/components/schemas/DailySpend"
            },
            "type": "array"
          },
          "effective_enabled": {
            "type": "boolean"
          },
          "enabled_override": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "sign_counts": {
            "$ref": "#/components/schemas/SignCounts"
          }
        },
        "required": [
          "effective_enabled",
          "enabled_override",
          "daily_spend",
          "sign_counts"
        ],
        "type": "object"
      },
      "PolicySnapshot": {
        "properties": {
          "address": {
            "type": "string"
          },
          "baseline_policy": {
            "$ref": "#/components/schemas/KeyPolicy",
            "description": "Admin responses only."
          },
          "chain": {
            "enum": [
              "solana",
              "cosmos",
              "unknown"
            ],
            "type": "string"
          },
          "derivation_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "effective_enabled": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          },
          "object_id": {
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "overlay": {
            "$ref": "#/components/schemas/KeyPolicyPatch",
            "description": "Admin responses only."
          },
          "policy": {
            "$ref": "#/components/schemas/KeyPolicy"
          },
          "policy_source": {
            "description": "Admin responses only.",
            "enum": [
              "config",
              "config+overlay"
            ],
            "type": "string"
          },
          "runtime": {
            "$ref": "#/components/schemas/PolicyRuntime"
          }
        },
        "required": [
          "label",
          "chain",
          "address",
          "object_id",
          "derivation_path",
          "effective_enabled",
          "policy",
          "runtime"
        ],
        "type": "object"
      },
      "PoolKeyEntry": {
        "properties": {
          "address": {
            "type": "string"
          },
          "allocatable": {
            "type": "boolean"
          },
          "chain": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "chain",
          "allocatable"
        ],
        "type": "object"
      },
      "PoolSummary": {
        "properties": {
          "chains": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ChainPoolStats"
            },
            "type": "object"
          },
          "keys": {
            "items": {
              "$ref": "#/components/schemas/PoolKeyEntry"
            },
            "type": "array"
          }
        },
        "required": [
          "chains"
        ],
        "type": "object"
      },
      "SignCounts": {
        "properties": {
          "per_day": {
            "$ref": "#/components/schemas/WindowSignCount"
          },
          "per_hour": {
            "$ref": "#/components/schemas/WindowSignCount"
          },
          "per_minute": {
            "$ref": "#/components/schemas/WindowSignCount"
          }
        },
        "type": "object"
      },
      "SignResponse": {
        "properties": {
          "signature_b64": {
            "description": "Base64-encoded 64-byte signature.",
            "type": "string"
          }
        },
        "required": [
          "signature_b64"
        ],
        "type": "object"
      },
      "SolanaAddressLookupTable": {
        "additionalProperties": false,
        "properties": {
          "addresses": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "key": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "addresses"
        ],
        "type": "object"
      },
      "SolanaSignRequest": {
        "additionalProperties": false,
        "properties": {
          "address_lookup_tables": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/SolanaAddressLookupTable"
            },
            "type": "array"
          },
          "expected_chain_id": {
            "description": "Optional audit/log context; Solana messages do not embed chain id.",
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "message_b64": {
            "description": "Base64-encoded Solana VersionedMessage.",
            "type": "string"
          }
        },
        "required": [
          "label",
          "message_b64"
        ],
        "type": "object"
      },
      "WindowSignCount": {
        "properties": {
          "limit": {
            "minimum": 0,
            "type": "integer"
          },
          "used": {
            "minimum": 0,
            "type": "integer"
          },
          "window_secs": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "limit",
          "used",
          "window_secs"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "adminBearer": {
        "description": "Bearer token loaded from admin_token_file.",
        "scheme": "bearer",
        "type": "http"
      },
      "signerBearer": {
        "description": "Per-client pairing token issued on admin approve (scoped to one key label).",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "YubiHSM2-backed transaction signer for Cosmos and Solana.",
    "title": "openKMS HTTP API",
    "version": "0.1.0-rc.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/keys/{label}/disable": {
      "post": {
        "operationId": "disableKey",
        "parameters": [
          {
            "description": "Configured key label.",
            "in": "path",
            "name": "label",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminKeyResponse"
                }
              }
            },
            "description": "Key enabled state was updated."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "adminBearer": []
          }
        ],
        "summary": "Disable a configured key",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/keys/{label}/enable": {
      "post": {
        "operationId": "enableKey",
        "parameters": [
          {
            "description": "Configured key label.",
            "in": "path",
            "name": "label",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminKeyResponse"
                }
              }
            },
            "description": "Key enabled state was updated."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "adminBearer": []
          }
        ],
        "summary": "Enable a configured key",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/keys/{label}/policy": {
      "delete": {
        "operationId": "adminDeletePolicy",
        "parameters": [
          {
            "description": "Configured key label.",
            "in": "path",
            "name": "label",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicySnapshot"
                }
              }
            },
            "description": "Policy overlay was updated and effective policy was reloaded."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "adminBearer": []
          }
        ],
        "summary": "Clear the persisted per-key policy overlay",
        "tags": [
          "admin"
        ]
      },
      "get": {
        "operationId": "adminGetPolicy",
        "parameters": [
          {
            "description": "Configured key label.",
            "in": "path",
            "name": "label",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicySnapshot"
                }
              }
            },
            "description": "Effective policy snapshot and live usage counters."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "adminBearer": []
          }
        ],
        "summary": "Get a key policy snapshot with admin overlay metadata",
        "tags": [
          "admin"
        ]
      },
      "patch": {
        "operationId": "adminPatchPolicy",
        "parameters": [
          {
            "description": "Configured key label.",
            "in": "path",
            "name": "label",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KeyPolicyPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
