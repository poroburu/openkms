{
  "components": {
    "responses": {
      "BadRequest": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Request payload could not be decoded or validated."
      },
      "Forbidden": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Policy denied the request."
      },
      "InternalError": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Internal server or HSM error."
      },
      "NotFound": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Requested key label was not found."
      },
      "RateLimited": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Rate-limit policy denied the request."
      },
      "Unauthorized": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Bearer token is missing or invalid."
      }
    },
    "schemas": {
      "AdminKeyResponse": {
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "enabled"
        ],
        "type": "object"
      },
      "AllowedMessage": {
        "properties": {
          "allowed_contracts": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "allowed_methods": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "allowed_recipients": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "comment": {
            "type": [
              "string",
              "null"
            ]
          },
          "per_tx_cap": {
            "additionalProperties": {
              "type": "string"
            },
            "type": [
              "object",
              "null"
            ]
          },
          "type_url": {
            "type": "string"
          }
        },
        "required": [
          "type_url"
        ],
        "type": "object"
      },
      "AllowedProgram": {
        "properties": {
          "comment": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "AllowedRecipient": {
        "properties": {
          "addresses": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "program": {
            "type": "string"
          }
        },
        "required": [
          "program",
          "addresses"
        ],
        "type": "object"
      },
      "CosmosSignRequest": {
        "additionalProperties": false,
        "properties": {
          "expected_chain_id": {
            "description": "Must match the chain_id inside the decoded SignDoc.",
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "sign_doc_b64": {
            "description": "Base64-encoded cosmos.tx.v1beta1.SignDoc.",
            "type": "string"
          }
        },
        "required": [
          "label",
          "sign_doc_b64",
          "expected_chain_id"
        ],
        "type": "object"
      },
      "DailySpend": {
        "properties": {
          "cap": {
            "type": [
              "string",
              "null"
            ]
          },
          "day_unix": {
            "type": "integer"
          },
          "spent": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token",
          "day_unix",
          "spent",
          "cap"
        ],
        "type": "object"
      },
      "Error": {
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "type": "string"
          },
          "vault_up": {
            "description": "Null on the first response after process start; boolean thereafter.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "vault_up"
        ],
        "type": "object"
      },
      "KeyPolicy": {
        "properties": {
          "allowed_messages": {
            "items": {
              "$ref": "#/components/schemas/AllowedMessage"
            },
            "type": "array"
          },
          "allowed_programs": {
            "items": {
              "$ref": "#/components/schemas/AllowedProgram"
            },
            "type": "array"
          },
          "allowed_recipients": {
            "items": {
              "$ref": "#/components/schemas/AllowedRecipient"
            },
            "type": "array"
          },
          "daily_cap_lamports": {
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "max_signs_per_day": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_signs_per_hour": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_signs_per_minute": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "per_tx_cap_lamports": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "KeyPolicyPatch": {
        "description": "Partial overlay. Non-null fields present in a PATCH replace the corresponding baseline policy field.",
        "properties": {
          "allowed_messages": {
            "items": {
              "$ref": "#/components/schemas/AllowedMessage"
            },
            "type": "array"
          },
          "allowed_programs": {
            "items": {
              "$ref": "#/components/schemas/AllowedProgram"
            },
            "type": "array"
          },
          "allowed_recipients": {
            "items": {
              "$ref": "#/components/schemas/AllowedRecipient"
            },
            "type": "array"
          },
          "daily_cap_lamports": {
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "max_signs_per_day": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_signs_per_hour": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "max_signs_per_minute": {
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "per_tx_cap_lamports": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "KeySummary": {
        "properties": {
          "address": {
            "type": "string"
          },
          "chain": {
            "enum": [
              "solana",
              "cosmos",
              "unknown"
            ],
            "type": "string"
          },
          "derivation_path": {
            "examples": [
              "m/44'/118'/0'/0/0"
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "key_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "vault": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "chain",
          "address",
          "enabled",
          "vault",
          "key_id",
          "derivation_path"
        ],
        "type": "object"
      },
      "PolicyRuntime": {
        "properties": {
          "daily_spend": {
            "items": {
              "$ref": "#/components/schemas/DailySpend"
            },
            "type": "array"
          },
          "effective_enabled": {
            "type": "boolean"
          },
          "enabled_override": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "sign_counts": {
            "$ref": "#/components/schemas/SignCounts"
          }
        },
        "required": [
          "effective_enabled",
          "enabled_override",
          "daily_spend",
          "sign_counts"
        ],
        "type": "object"
      },
      "PolicySnapshot": {
        "properties": {
          "address": {
            "type": "string"
          },
          "baseline_policy": {
            "$ref": "#/components/schemas/KeyPolicy",
            "description": "Admin responses only."
          },
          "chain": {
            "enum": [
              "solana",
              "cosmos",
              "unknown"
            ],
            "type": "string"
          },
          "derivation_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "effective_enabled": {
            "type": "boolean"
          },
          "key_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "overlay": {
            "$ref": "#/components/schemas/KeyPolicyPatch",
            "description": "Admin responses only."
          },
          "policy": {
            "$ref": "#/components/schemas/KeyPolicy"
          },
          "policy_source": {
            "description": "Admin responses only.",
            "enum": [
              "config",
              "config+overlay"
            ],
            "type": "string"
          },
          "runtime": {
            "$ref": "#/components/schemas/PolicyRuntime"
          },
          "vault": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "chain",
          "address",
          "vault",
          "key_id",
          "derivation_path",
          "effective_enabled",
          "policy",
          "runtime"
        ],
        "type": "object"
      },
      "SignCounts": {
        "properties": {
          "per_day": {
            "$ref": "#/components/schemas/WindowSignCount"
          },
          "per_hour": {
            "$ref": "#/components/schemas/WindowSignCount"
          },
          "per_minute": {
            "$ref": "#/components/schemas/WindowSignCount"
          }
        },
        "type": "object"
      },
      "SignResponse": {
        "properties": {
          "signature_b64": {
            "description": "Base64-encoded 64-byte signature.",
            "type": "string"
          }
        },
        "required": [
          "signature_b64"
        ],
        "type": "object"
      },
      "SolanaAddressLookupTable": {
        "additionalProperties": false,
        "properties": {
          "addresses": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "key": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "addresses"
        ],
        "type": "object"
      },
      "SolanaSignRequest": {
        "additionalProperties": false,
        "properties": {
          "address_lookup_tables": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/SolanaAddressLookupTable"
            },
            "type": "array"
          },
          "expected_chain_id": {
            "description": "Optional audit/log context; Solana messages do not embed chain id.",
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "message_b64": {
            "description": "Base64-encoded Solana VersionedMessage.",
            "type": "string"
          }
        },
        "required": [
          "label",
          "message_b64"
        ],
        "type": "object"
      },
      "WindowSignCount": {
        "properties": {
          "limit": {
            "minimum": 0,
            "type": "integer"
          },
          "used": {
            "minimum": 0,
            "type": "integer"
          },
          "window_secs": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "limit",
          "used",
          "window_secs"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "adminBearer": {
        "description": "Bearer token loaded from admin_token_file.",
        "scheme": "bearer",
        "type": "http"
      },
      "signerBearer": {
        "description": "Bearer token loaded from signer_token_file.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "YubiHSM2-backed transaction signer for Cosmos and Solana.",
    "title": "openKMS HTTP API",
    "version": "0.1.0-rc.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/admin/keys/{label}/disable": {
      "post": {
        "operationId": "disableKey",
        "parameters": [
          {
            "description": "Configured key label.",
            "in": "path",
            "name": "label",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminKeyResponse"
                }
              }
            },
            "description": "Key enabled state was updated."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "adminBearer": []
          }
        ],
        "summary": "Disable a configured key",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/keys/{label}/enable": {
      "post": {
        "operationId": "enableKey",
        "parameters": [
          {
            "description": "Configured key label.",
            "in": "path",
            "name": "label",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminKeyResponse"
                }
              }
            },
            "description": "Key enabled state was updated."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "adminBearer": []
          }
        ],
        "summary": "Enable a configured key",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/keys/{label}/policy": {
      "delete": {
        "operationId": "adminDeletePolicy",
        "parameters": [
          {
            "description": "Configured key label.",
            "in": "path",
            "name": "label",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicySnapshot"
                }
              }
            },
            "description": "Policy overlay was updated and effective policy was reloaded."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "adminBearer": []
          }
        ],
        "summary": "Clear the persisted per-key policy overlay",
        "tags": [
          "admin"
        ]
      },
      "get": {
        "operationId": "adminGetPolicy",
        "parameters": [
          {
            "description": "Configured key label.",
            "in": "path",
            "name": "label",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicySnapshot"
                }
              }
            },
            "description": "Effective policy snapshot and live usage counters."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "adminBearer": []
          }
        ],
        "summary": "Get a key policy snapshot with admin overlay metadata",
        "tags": [
          "admin"
        ]
      },
      "patch": {
        "operationId": "adminPatchPolicy",
        "parameters": [
          {
            "description": "Configured key label.",
            "in": "path",
            "name": "label",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KeyPolicyPatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicySnapshot"
                }
              }
            },
            "description": "Policy overlay was updated and effective policy was reloaded."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "adminBearer": []
          }
        ],
        "summary": "Patch a persisted per-key policy overlay",
        "tags": [
          "admin"
        ]
      }
    },
    "/admin/policy": {
      "get": {
        "operationId": "adminListPolicy",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PolicySnapshot"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Effective policy snapshots and live usage counters."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "adminBearer": []
          }
        ],
        "summary": "List policy snapshots with admin overlay metadata",
        "tags": [
          "admin"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The service is reachable."
          }
        },
        "summary": "Report service and HSM health",
        "tags": [
          "health"
        ]
      }
    },
    "/keys": {
      "get": {
        "operationId": "listKeys",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/KeySummary"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Configured keys with derived addresses and enabled state."
          }
        },
        "summary": "List configured signing keys",
        "tags": [
          "keys"
        ]
      }
    },
    "/metrics": {
      "get": {
        "operationId": "getMetrics",
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "examples": [
                    "openkms_signs_total{chain=\"solana\",label=\"solana-hot-0\",result=\"allow\"} 1"
                  ],
                  "type": "string"
                }
              }
            },
            "description": "Prometheus text exposition."
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "summary": "Expose Prometheus metrics",
        "tags": [
          "metrics"
        ]
      }
    },
    "/policy": {
      "get": {
        "operationId": "listPolicy",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PolicySnapshot"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Effective policy snapshots and live usage counters."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "signerBearer": []
          }
        ],
        "summary": "List effective signing policies and live usage",
        "tags": [
          "signing"
        ]
      }
    },
    "/policy/{label}": {
      "get": {
        "operationId": "getPolicy",
        "parameters": [
          {
            "description": "Configured key label.",
            "in": "path",
            "name": "label",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicySnapshot"
                }
              }
            },
            "description": "Effective policy snapshot and live usage counters."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "signerBearer": []
          }
        ],
        "summary": "Get effective signing policy and live usage for a key",
        "tags": [
          "signing"
        ]
      }
    },
    "/sign/cosmos": {
      "post": {
        "operationId": "signCosmos",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CosmosSignRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignResponse"
                }
              }
            },
            "description": "Signature produced or returned from replay cache."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "signerBearer": []
          }
        ],
        "summary": "Sign a Cosmos SDK SignDoc",
        "tags": [
