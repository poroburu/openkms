# Paste into GitHub: Settings → Secrets and variables → Actions.
# Replace HOST with MagicDNS name (e.g. raspberrypi) or tailnet IP.
#
# Required secrets
OPENKMS_BASE_URL=http://HOST:8443
OPENKMS_SIGNER_TOKEN=paste-from-/etc/openkms/signer.token-on-Pi
OPENKMS_REMOTE_E2E_SOLANA_REQUEST_B64=
OPENKMS_REMOTE_E2E_COSMOS_REQUEST_B64=
TAILSCALE_OAUTH_CLIENT_ID=
TAILSCALE_OAUTH_CLIENT_SECRET=
#
# Optional secrets
# OPENKMS_TAILSCALE_PING_HOST=raspberrypi
#
# Optional variables (repository)
# TAILSCALE_OAUTH_TAGS=tag:ci
# OPENKMS_EXPECT_SOLANA_KEY_LABEL=solana-hot-0
# OPENKMS_EXPECT_COSMOS_KEY_LABEL=cosmos-hub-0
